#, python-format
msgid "%s at %d, %d"
msgstr "%s em %d, %d"

msgid "Usage: big-wm-display-resolution [OPTION]\n\nMonitors of the X11 (Window Maker) and Wayland (wlmaker) sessions.\n\n  (none)                 open the window (or raise the open one)\n  --restore              at login: apply the profile of the connected set\n                         of monitors (no window)\n  --hotplug              the same, run by the watcher when a monitor\n                         is plugged in or out\n  --watch                hotplug watcher (replaces this process with\n                         big-wm-display-helper)\n  --show                 what is connected and the profile that applies\n  --profiles             list the profiles\n  --apply-profile NAME   apply a profile (no confirmation)\n  --version              show the version\n"
msgstr "Uso: big-wm-display-resolution [OPÇÃO]\n\nMonitores das sessões X11 (Window Maker) e Wayland (wlmaker).\n\n  (nenhuma)              abre a janela (ou traz a que já está aberta)\n  --restore              no login: aplica o perfil do conjunto de\n                         monitores conectado (sem janela)\n  --hotplug              o mesmo, chamado pelo vigia quando um monitor\n                         é conectado ou desconectado\n  --watch                vigia de conexão de monitores (troca este\n                         processo pelo big-wm-display-helper)\n  --show                 o que está conectado e o perfil que vale\n  --profiles             lista os perfis\n  --apply-profile NOME   aplica um perfil (sem confirmação)\n  --version              mostra a versão\n"

