msgid_plural "Reverting to the previous configuration in %d seconds."
msgstr[0] "Voltando à configuração anterior em %d segundo."
msgstr[1] "Voltando à configuração anterior em %d segundos."

msgid "The confirmation came too late; the previous configuration was restored."
msgstr "A confirmação chegou tarde demais; a configuração anterior foi restaurada."

msgid "Configuration kept and saved for this set of monitors."
msgstr "Configuração mantida e salva para este conjunto de monitores."

msgid "Could not restore the previous configuration automatically."
msgstr "Não foi possível restaurar a configuração anterior automaticamente."

