msgid "Landscape"
msgstr "Paisagem"

msgid "Portrait (rotated left)"
msgstr "Retrato (girado à esquerda)"

msgid "Landscape (upside down)"
msgstr "Paisagem (de cabeça para baixo)"

msgid "Portrait (rotated right)"
msgstr "Retrato (girado à direita)"

msgid "At least one monitor must stay on."
msgstr "Pelo menos um monitor precisa ficar ligado."

#, python-format
msgid "%(name)s has no resolution."
msgstr "%(name)s está sem resolução."

#, python-format
msgid "%(name)s does not announce the mode %(mode)s."
msgstr "%(name)s não anuncia o modo %(mode)s."

#, python-format
msgid "%(name)s does not support this orientation."
msgstr "%(name)s não aceita esta orientação."

#, python-format
msgid "%(name)s: per-monitor scale does not exist on X11."
msgstr "%(name)s: escala por monitor não existe no X11."

#, python-format
msgid "%(name)s: the scale must be between 1 and 3."
msgstr "%(name)s: a escala precisa ficar entre 1 e 3."

#, python-format
msgid "%(name)s mirrors a monitor that is off or is itself a mirror."
msgstr "%(name)s espelha um monitor desligado ou que já é um espelho."

#, python-format
msgid "%(name)s and %(source)s need the same resolution to mirror."
msgstr "%(name)s e %(source)s precisam da mesma resolução para espelhar."

#, python-format
msgid "%(a)s and %(b)s overlap."
msgstr "%(a)s e %(b)s estão sobrepostos."

msgid "The monitors must touch each other: there is a gap between them."
msgstr "Os monitores precisam se encostar: há um vão entre eles."

msgid "Negative positions are not allowed."
msgstr "Posições negativas não são permitidas."

#, python-format
msgid "The arrangement (%(w)dx%(h)d) exceeds the maximum screen size (%(mw)dx%(mh)d)."
msgstr "A disposição (%(w)dx%(h)d) passa do tamanho máximo da tela (%(mw)dx%(mh)d)."

msgid "Only one monitor can be the primary one."
msgstr "Só um monitor pode ser o principal."

